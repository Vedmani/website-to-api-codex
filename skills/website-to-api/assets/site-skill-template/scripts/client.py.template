"""SITE_DISPLAY_NAME internal API client.

Customize every endpoint, command, and response parser before validating the
generated skill. Remove all placeholders from the final client.
"""

import json
import os
import re
from typing import Any, Dict, Mapping

import httpx
import typer
from rich.console import Console


API_BASE = "SITE_API_BASE"
COOKIE_NAME = "COOKIE_NAME_OR_EMPTY"
AUTH_COOKIE_ENV = "SITE_UPPER_AUTH_COOKIE"
COOKIE_HEADER_ENV = "SITE_UPPER_COOKIE_HEADER"
USER_AGENT_ENV = "SITE_UPPER_USER_AGENT"
SENSITIVE_NAME = re.compile(
    r"(?:auth|cookie|credential|csrf|jwt|password|secret|session|token|xsrf|api.?key)",
    re.IGNORECASE,
)

app = typer.Typer(help="SITE_DISPLAY_NAME API client")
console = Console()


@app.callback()
def main() -> None:
    """Use verified SITE_DISPLAY_NAME API commands."""


def redact(value: Any, key: str = "") -> Any:
    """Remove secret-like fields from error output."""
    if key and SENSITIVE_NAME.search(key):
        return "<redacted>"
    if isinstance(value, Mapping):
        return {str(k): redact(v, str(k)) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(item) for item in value]
    return value


def make_client() -> httpx.Client:
    """Create an HTTP client without logging credential values."""
    headers = {"accept": "application/json, text/plain, */*"}
    cookies = {}

    user_agent = os.environ.get(USER_AGENT_ENV, "")
    raw_cookie_header = os.environ.get(COOKIE_HEADER_ENV, "")
    single_cookie = os.environ.get(AUTH_COOKIE_ENV, "")

    if user_agent:
        headers["user-agent"] = user_agent
    if raw_cookie_header:
        headers["cookie"] = raw_cookie_header
    elif single_cookie and COOKIE_NAME:
        cookies[COOKIE_NAME] = single_cookie

    return httpx.Client(
        base_url=API_BASE,
        headers=headers,
        cookies=cookies,
        follow_redirects=True,
        timeout=httpx.Timeout(60.0, connect=15.0),
    )


def raise_api_error(response: httpx.Response) -> None:
    if response.is_success:
        return
    try:
        detail: Any = redact(response.json())
        rendered = json.dumps(detail, ensure_ascii=False)
    except Exception:
        content_type = response.headers.get("content-type", "unknown")
        rendered = f"<non-JSON response body omitted; content-type={content_type}>"
    rendered = rendered[:1000]
    console.print(
        f"[red]SITE_DISPLAY_NAME API returned {response.status_code}:[/red] {rendered}",
        stderr=True,
    )
    raise typer.Exit(1)


def parse_answer(data: Dict[str, Any]) -> str:
    """Convert the discovered response shape into user-facing text."""
    # TODO: replace with the site-specific response parser.
    return str(data)


@app.command()
def example(
    query: str = typer.Argument(..., help="Example query or resource identifier."),
    raw: bool = typer.Option(False, "--raw", help="Print the full JSON response."),
) -> None:
    """Replace this command with the verified site-specific workflow."""
    with make_client() as http:
        response = http.get("SITE_ENDPOINT", params={"q": query})
        raise_api_error(response)
        data = response.json()

    if raw:
        console.print_json(data=data)
        return
    console.print(parse_answer(data))


if __name__ == "__main__":
    app()
